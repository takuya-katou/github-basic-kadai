        "class Human:\n",
        "    def __init__(self):\n",
        "        self.name = \"\"\n",
        "        self.age = \"\"\n",
        "\n",
        "    def printinfo(self, name, age):\n",
        "        self.name = name\n",
        "        self.age = age\n",
        "        print(self.name, age)\n",
        "\n",
        "info = Human()\n",
        "\n",
        "info.printinfo(\"名前\", \"年齢\")\n"
